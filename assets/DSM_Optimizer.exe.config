<?xml version="1.0" encoding="utf-8"?>
<!--
  Sits next to DSM_Optimizer.exe. Purpose: the portable ZIP is downloaded
  from the internet, so Windows Explorer tags every extracted file with the
  Mark of the Web - and .NET Framework refuses to load tagged assemblies,
  which kills pywebview's native window (pythonnet's Python.Runtime.dll
  fails with "Failed to resolve ... Loader.Initialize").

  loadFromRemoteSources tells .NET to grant those assemblies full trust
  anyway. Scope of that relaxation: this process only, and the only
  assemblies it loads are the ones shipped in this same folder. The
  installer build does not need this (installer-written files are untagged),
  but the file is harmless there.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
